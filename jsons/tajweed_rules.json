      "rules": [
        {
          "id": "izhar",
          "title": "Iẓhār (Clear Pronunciation)",
          "arabicTitle": "الإظهار",
          "category": "Noon Sākinah & Tanween",
          "description": "When Noon Sākinah (نْ) or Tanween (ً ٌ ٍ) is followed by one of the six throat letters (ء ه ع ح غ خ), the Noon is pronounced clearly without Ghunnah.",
          "example": "مَنْ آمَنَ",
          "exampleTranslation": "Man āmana",
          "tags": ["throat letters", "clear", "no ghunnah"],
          "details": [
            {
              "subtitle": "Throat Letters",
              "content": "ء ه ع ح غ خ (Hamza, Hā, ʿAyn, Ḥā, Ghayn, Khā)",
              "exampleArabic": "مَنْ آمَنَ",
              "exampleTranslit": "Man āmana"
            },
            {
              "subtitle": "Rule",
              "content": "Pronounce Noon clearly, no nasalization, no doubling.",
              "exampleArabic": "مَنْ هَادَ",
              "exampleTranslit": "Man hāda"
            }
          ]
        },
        {
          "id": "idgham",
          "title": "Idghām (Merging)",
          "arabicTitle": "الإدغام",
          "category": "Noon Sākinah & Tanween",
          "description": "When Noon Sākinah or Tanween is followed by one of the letters (ي ر م ل و ن), the Noon merges into the following letter.",
          "example": "مَنْ يَعْمَلْ",
          "exampleTranslation": "May yaʿmal",
          "tags": ["merging", "ghunnah", "yarmaloon"],
          "details": [
            {
              "subtitle": "Idghām with Ghunnah",
              "content": "Letters: ي ن م و — Merging with nasalization for 2 counts",
              "exampleArabic": "مَنْ يَعْمَلْ",
              "exampleTranslit": "May yaʿmal"
            },
            {
              "subtitle": "Idghām without Ghunnah",
              "content": "Letters: ل ر — Complete merging without nasalization",
              "exampleArabic": "مِنْ رَبِّهِمْ",
              "exampleTranslit": "Mir rabbihim"
            }
          ]
        },
        {
          "id": "iqlab",
          "title": "Iqlāb (Conversion)",
          "arabicTitle": "الإقلاب",
          "category": "Noon Sākinah & Tanween",
          "description": "When Noon Sākinah or Tanween is followed by Bā (ب), the Noon converts to a Mīm (م) with Ghunnah for 2 counts.",
          "example": "مِنْ بَعْدِ",
          "exampleTranslation": "Mim baʿdi",
          "tags": ["conversion", "meem", "ba"],
          "details": [
            {
              "subtitle": "Rule",
              "content": "Noon becomes Mīm, hold Ghunnah for 2 counts",
              "exampleArabic": "أَنْبِئْهُمْ",
              "exampleTranslit": "Ambihum"
            },
            {
              "subtitle": "Note",
              "content": "The lips should close for the Mīm sound.",
              "exampleArabic": "سَمِيعٌ بَصِيرٌ",
              "exampleTranslit": "Samīʿum baṣīr"
            }
          ]
        },
        {
          "id": "ikhfa",
          "title": "Ikhfāʾ (Concealment)",
          "arabicTitle": "الإخفاء",
          "category": "Noon Sākinah & Tanween",
          "description": "When Noon Sākinah or Tanween is followed by any of the 15 Ikhfāʾ letters, the Noon is concealed with Ghunnah for 2 counts.",
          "example": "مِنْ قَبْلِ",
          "exampleTranslation": "Mim qabli",
          "tags": ["concealment", "15 letters"],
          "details": [
            {
              "subtitle": "Ikhfāʾ Letters",
              "content": "15 letters: ت ث ج د ذ ز س ش ص ض ط ظ ف ق ك",
              "exampleArabic": "أَنْتُمْ",
              "exampleTranslit": "Antum"
            },
            {
              "subtitle": "Rule",
              "content": "Noon is hidden, Ghunnah held for 2 counts",
              "exampleArabic": "مِنْ شَرِّ",
              "exampleTranslit": "Mim shar"
            }
          ]
        }
      ]
    },
